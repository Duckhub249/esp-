local function startAimbot(target, duration)
    if not target or not target.Parent then return end

    if activeAimbotLoop then
        activeAimbotLoop:Disconnect()
        activeAimbotLoop = nil
    end

    local startTime = os.clock()
    local lockDuration = duration or Settings.AimbotDuration or 1
    local aimSpeed = Settings.AimbotSpeed or 1
    local prediction = Settings.AimbotPrediction or 0.4

    local lastLookVector = target.CFrame.LookVector

    activeAimbotLoop = RunService.RenderStepped:Connect(function()
        if os.clock() - startTime >= lockDuration or not target or not target.Parent or not LocalPlayer.Character then
            if activeAimbotLoop then
                activeAimbotLoop:Disconnect()
                activeAimbotLoop = nil
            end
            return
        end

        local HRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local camera = Workspace.CurrentCamera
        if not HRP or not camera then return end

        local myPos = HRP.Position
        local targetPos = target.Position
        local dist = (targetPos - myPos).Magnitude

        local currentLook = target.CFrame.LookVector
        local predictedPosition = targetPos

        -- เงื่อนไข: ถ้าห่างเกิน 10 studs ให้เริ่มคำนวณการดักหน้า
        if dist > 10 then
            local targetVel = target.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            local flatVel = Vector3.new(targetVel.X, 0, targetVel.Z)
            
            local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z).Unit
            local toPlayerDir = (myPos - targetPos).Unit
            local moveDir = (flatVel.Magnitude > 1.5) and flatVel.Unit or flatLook

            -- ตรวจสอบว่า Killer วิ่งตรงเข้าหาผู้เล่นหรือไม่ (วิ่งเข้าหาตรงๆ = ไม่ดักหน้า)
            local isApproachingStraight = moveDir:Dot(toPlayerDir) > 0.82

            -- ตรวจสอบการหมุนลำตัว/เลี้ยว (ปรับความไว Dot Product + ตรวจความเร็วการหมุนเชิงมุม Y)
            local turnDot = lastLookVector:Dot(currentLook)
            local angularVelY = math.abs(target.AssemblyAngularVelocity.Y)
            local isTurning = (turnDot < 0.9995) or (angularVelY > 0.3)

            -- ถ้าไม่ได้วิ่งเข้าหาตรงๆ ให้ทำการล็อคล่วงหน้า
            if not isApproachingStraight then
                if isTurning then
                    -- ทันทีที่ลำตัวหมุน/เลี้ยว ให้พุ่งจุดล็อคไปทางทิศที่หันไปทันที
                    local turnPredict = flatLook * (prediction * 14)
                    local velPredict = flatVel * prediction
                    predictedPosition = targetPos + turnPredict + velPredict
                elseif flatVel.Magnitude > 2 then
                    -- วิ่งฉีกข้างปกติโดยไม่เลี้ยว
                    predictedPosition = targetPos + (flatVel * prediction)
                end
            end
        end

        -- อัปเดต lastLookVector นอกเงื่อนไขเพื่อให้เก็บค่าความเคลื่อนไหวทุกเฟรม
        lastLookVector = currentLook

        -- ปรับหมุนกล้องและหันหน้าตัวละคร
        local targetCameraCFrame = CFrame.new(camera.CFrame.Position, predictedPosition)
        camera.CFrame = camera.CFrame:Lerp(targetCameraCFrame, aimSpeed)

        local targetHRPCFrame = CFrame.new(HRP.Position, Vector3.new(predictedPosition.X, HRP.Position.Y, predictedPosition.Z))
        HRP.CFrame = HRP.CFrame:Lerp(targetHRPCFrame, aimSpeed)
    end)
end

