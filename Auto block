local function updateDropdownList()
    for _, child in ipairs(listContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local count = 0
    for _ in pairs(ConfigsStorage) do count = count + 1 end
    
    listContainer.Size = UDim2.new(1, 0, 0, count * 30)
    
    for name, savedData in pairs(ConfigsStorage) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 30)
        optBtn.BackgroundTransparency = 1
        optBtn.Text = "   " .. name
        optBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 12
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.ZIndex = 11
        optBtn.Parent = listContainer
        
        optBtn.MouseButton1Click:Connect(function()
            currentSelectedConfigName = name
            dropdownDisplay.Text = "  📁 " .. name
            listContainer.Visible = false
        end)
    end
end

local function toggleDropdown()
    listContainer.Visible = not listContainer.Visible
end
arrowBtn.MouseButton1Click:Connect(toggleDropdown)
dropdownDisplay.MouseButton1Click:Connect(toggleDropdown)

saveBtn.MouseButton1Click:Connect(function()
    local name = configNameInput
    if name == "" then
        configTextBox.PlaceholderText = "กรุณาใส่ชื่อก่อน!"
        task.delay(1, function() configTextBox.PlaceholderText = "Max 3 profiles..." end)
        return
    end
    
    local totalCount = 0
    for _ in pairs(ConfigsStorage) do totalCount = totalCount + 1 end
    
    if not ConfigsStorage[name] and totalCount >= MAX_CONFIGS then
        configTextBox.Text = ""
        configTextBox.PlaceholderText = "บันทึกได้สูงสุด 3 เท่านั้น!"
        task.delay(1, function() configTextBox.PlaceholderText = "Max 3 profiles..." end)
        return
    end
    
    local dataToSave = {}
    for k, v in pairs(Settings) do
        if type(v) ~= "table" then dataToSave[k] = v end
    end
    
    ConfigsStorage[name] = dataToSave
    saveConfigFile(ConfigsStorage)
    
    currentSelectedConfigName = name
    dropdownDisplay.Text = "  📁 " .. name
    configTextBox.Text = ""
    updateDropdownList()
end)

loadBtn.MouseButton1Click:Connect(function()
    if currentSelectedConfigName ~= "" and ConfigsStorage[currentSelectedConfigName] then
        local savedData = ConfigsStorage[currentSelectedConfigName]
        for k, v in pairs(savedData) do
            if Settings[k] ~= nil then Settings[k] = v end
        end
        ApplyLanguage()
    end
end)

deleteBtn.MouseButton1Click:Connect(function()
    if currentSelectedConfigName ~= "" and ConfigsStorage[currentSelectedConfigName] then
        ConfigsStorage[currentSelectedConfigName] = nil
        saveConfigFile(ConfigsStorage)
        currentSelectedConfigName = ""
        dropdownDisplay.Text = Settings.Language == "TH" and "  📁 เลือกโปรไฟล์..." or "  📁 Select Profile..."
        updateDropdownList()
    end
end)

